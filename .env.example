# ---------------------------------------------------------------------------
# Database
# The app connects here, then drops to the unprivileged `app` role inside every
# request transaction so row-level security applies. Do not point this at a
# superuser in production — table owners bypass RLS.
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://localhost/marginly

# ---------------------------------------------------------------------------
# Session signing key. REQUIRED — the app refuses to start without it and
# rejects anything that looks like a placeholder.
#   openssl rand -hex 32
# ---------------------------------------------------------------------------
SESSION_SECRET=

PORT=3000
NODE_ENV=development

# ---------------------------------------------------------------------------
# Asana (optional). The app runs normally without these; the Integrations
# screen simply reports "not connected".
#
# Create an app at https://app.asana.com/0/my-apps and paste its OAuth client
# id and secret here. If your organisation requires a Service Account, an Asana
# super admin must create it and supply the token — a personal access token
# belonging to an employee must NOT be used: it breaks when they leave and
# carries their permissions, not the integration's.
# The secret is read server-side only and never reaches the browser.
# ---------------------------------------------------------------------------
# ASANA_CLIENT_ID=
# ASANA_CLIENT_SECRET=
# ASANA_REDIRECT_URI=http://localhost:3000/api/integrations/asana/callback

# ---------------------------------------------------------------------------
# Email (optional). Without it, notifications are stored in-app only.
# ---------------------------------------------------------------------------
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# MAIL_FROM="KDC Digital <billing@kdc.pk>"

# ---------------------------------------------------------------------------
# Encryption key for third-party tokens at rest (Asana, and anything added
# later). Falls back to SESSION_SECRET if unset, but a separate key is better:
# rotating your session secret should not make every stored token unreadable.
#   openssl rand -hex 32
# ---------------------------------------------------------------------------
# ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Document storage. Local disk by default; point this at a mounted volume in
# production, or implement an S3 driver against the same three methods in
# src/storage.js (put, stream, remove).
# ---------------------------------------------------------------------------
# STORAGE_DIR=./storage
# MAX_UPLOAD_BYTES=26214400

# Used in notification emails to link back to the app.
# APP_URL=https://marginly.example.com

# Set to 1 only for local load testing.
# RATE_LIMIT_DISABLED=
